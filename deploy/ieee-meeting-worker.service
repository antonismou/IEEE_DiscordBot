# One processing run of the meeting job. Started every 2 minutes by ieee-meeting-worker.timer; when no meeting is
# pending, ExecCondition skips it before any container starts. During a call the run only transcribes the finished
# segments (no Ollama); once the meeting has ended it transcribes the rest and summarizes (see meeting-job.sh).
# Adjust the /home/docker/IEEE_DiscordBot paths to the folder that holds docker-compose.yml.
[Unit]
Description=IEEE bot meeting processing job (Whisper + Ollama, one shot)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/docker/IEEE_DiscordBot
# Exit 1 = nothing pending: the run is skipped and the unit is not marked failed.
ExecCondition=/bin/sh /home/docker/IEEE_DiscordBot/deploy/meeting-pending.sh /home/docker/IEEE_DiscordBot/data/meetings
# The fixed container name also makes a second run (for example a manual one) fail fast instead of overlapping;
# the worker additionally holds a flock in the meetings folder.
ExecStart=/bin/sh /home/docker/IEEE_DiscordBot/deploy/meeting-job.sh /home/docker/IEEE_DiscordBot/data/meetings
# Always clean up, even after a failure or a timeout: remove the job container if it is still there and stop Ollama
# (stopped, not removed, so `docker compose logs ollama` still works until the next run).
ExecStopPost=-/usr/bin/docker rm -f ieee-meeting-worker
ExecStopPost=-/usr/bin/docker compose --profile job stop ollama
# (a no-op after a live run during a call, which never starts Ollama)
# A 1-hour meeting takes about 1-1.5 hours to process; give it plenty but not forever.
TimeoutStartSec=8h
TimeoutStopSec=2min
# These apply to the docker client only; the containers get nice 19 / idle I/O from their own entrypoints.
Nice=19
IOSchedulingClass=idle
